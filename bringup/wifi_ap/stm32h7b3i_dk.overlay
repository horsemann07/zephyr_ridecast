
#include <zephyr/dt-bindings/gpio/gpio.h>

/* STM32 hardware RNG */
&rng {
    status = "okay";
};

/*
 * Onboard Inventek Wi-Fi module.
 * SPI2 uses the board's Wi-Fi wiring,
 * not its default Arduino pin mapping.
 */
&spi2 {
    status = "okay";

    pinctrl-0 = <&spi2_sck_pa12
                 &spi2_miso_pc2
                 &spi2_mosi_pc3>;

    pinctrl-names = "default";

    cs-gpios = <&gpioa 11 GPIO_ACTIVE_LOW>;

    wifi0: wifi@0 {
        compatible = "inventek,eswifi";
        reg = <0>;

        spi-max-frequency = <2000000>;

        resetn-gpios = <&gpioi 1 GPIO_ACTIVE_HIGH>;
        wakeup-gpios = <&gpioi 2 GPIO_ACTIVE_HIGH>;
        data-gpios = <&gpioi 5 GPIO_ACTIVE_HIGH>;

        status = "okay";
    };
};

/* Avoid conflicts on PA11/PA12 */
&fdcan1 {
    status = "disabled";
};
